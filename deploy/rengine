#!/usr/bin/env bash
# manage a reNgine install: start, stop, logs, update, backup
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
RENGINE_HOME="$(dirname "$(dirname "$SELF")")"
CALLER_PWD="$PWD"
abs() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$CALLER_PWD" "$1" ;; esac; }
cd "$RENGINE_HOME"

REPO="yogeshojha/rengine"
# every service that holds a database connection
SERVICES=(api worker-default worker-scans worker-control worker-beat channels ct-stream)

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
env_get() { grep -E "^$1=" .env 2>/dev/null | head -1 | cut -d= -f2-; }

WORK=""
cleanup() { [ -n "$WORK" ] && rm -rf "$WORK"; return 0; }
trap cleanup EXIT

[ -f .env ] || die "no .env in $RENGINE_HOME"

usage() {
  cat <<'EOF'
Usage: rengine <command>

  start          start the stack
  stop           stop the stack
  restart        stop and start the stack
  status         services and API health
  logs [svc]     follow logs, all services or one
  scale <n>      run n scan worker containers
  update [tag]   move to a release, the latest when no tag is given
                 --no-backup skips the database snapshot taken first
  backup         write a backup archive to ./backups
  restore <f>    replace this instance's data with an archive
  uninstall      remove containers and data volumes
  version        installed release
EOF
}

cmd_status() {
  docker compose ps
  local origin
  origin="$(env_get PUBLIC_ORIGIN)"
  [ -n "$origin" ] || return 0
  if curl -ksfm 5 "$origin/api/v1/health/health" >/dev/null 2>&1; then
    printf 'API answering at %s\n' "$origin"
  else
    printf 'The API did not respond. Check that the api service is running.\n'
  fi
}

running_scans() {
  docker compose exec -T db sh -c \
    'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -At -c "select count(*) from scans where status = '"'"'running'"'"'"' \
    2>/dev/null || true
}

cmd_update() {
  [ -n "$(env_get RENGINE_SRC)" ] && die "a source install. Update the checkout, then run install.sh --build again."
  [ -f api.env ] || die "api.env is missing. Run install.sh again to write it."
  local tag="" backup=1 arg
  for arg in "$@"; do
    case "$arg" in
      --no-backup) backup=0 ;;
      -*) die "unknown option: $arg" ;;
      *) tag="$arg" ;;
    esac
  done
  if [ -z "$tag" ]; then
    tag="$(curl -fsSLm 15 "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null \
      | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p')"
    [ -n "$tag" ] || die "GitHub did not answer. Pass a tag: rengine update v3.0.1"
  fi
  local image_tag="${tag#v}"
  local current
  current="$(env_get RENGINE_TAG)"
  if [ "$image_tag" = "$current" ]; then
    printf 'Already on %s.\n' "$image_tag"
    return 0
  fi
  printf 'Updating %s to %s\n' "${current:-unknown}" "$image_tag"
  local src
  WORK="$(mktemp -d)"
  curl -fsSL "https://github.com/$REPO/archive/refs/tags/$tag.tar.gz" | tar -xz -C "$WORK"
  src="$(find "$WORK" -maxdepth 1 -mindepth 1 -type d | head -1)"
  [ -f "$src/docker-compose.prod.yml" ] || die "the $tag archive has no docker-compose.prod.yml"
  cp "$src/docker-compose.prod.yml" docker-compose.prod.yml.new
  RENGINE_TAG="$image_tag" docker compose -f docker-compose.prod.yml.new -f ports.yml pull \
    || { rm -f docker-compose.prod.yml.new; die "the image pull failed. The install stays on $current."; }

  local snapshot=""
  if [ "$backup" -eq 1 ]; then
    printf 'Saving a database snapshot\n'
    docker compose up -d --wait db >/dev/null \
      && scripts/backup.sh snapshot "$RENGINE_HOME/backups" \
      || { rm -f docker-compose.prod.yml.new
           die "the database snapshot was not written. The install stays on $current. Free disk space, or pass --no-backup."; }
    snapshot="$(find backups -maxdepth 1 -name 'rengine-*-db.tar*' -printf '%T@ %p\n' | sort -rn | head -1 | cut -d' ' -f2-)"
  fi

  local scans
  scans="$(running_scans)"
  if [[ "$scans" =~ ^[1-9][0-9]*$ ]]; then
    printf 'Running scans: %s. Stages in flight run again after the update.\n' "$scans"
  fi
  docker compose stop "${SERVICES[@]}" >/dev/null 2>&1 || true

  mv docker-compose.prod.yml.new docker-compose.prod.yml
  mkdir -p scripts bin deploy
  [ ! -f "$src/deploy/seccomp-chromium.json" ] || install -m 644 "$src/deploy/seccomp-chromium.json" deploy/seccomp-chromium.json
  install -m 755 "$src/scripts/backup.sh" scripts/backup.sh
  install -m 755 "$src/deploy/rengine" bin/rengine
  sed -i "s|^RENGINE_TAG=.*|RENGINE_TAG=$image_tag|" .env
  if ! docker compose up -d --remove-orphans; then
    printf 'To return to %s: rengine update v%s --no-backup\n' "$current" "$current" >&2
    [ -z "$snapshot" ] || printf 'The database before the update: rengine restore %s\n' "$snapshot" >&2
    die "the update to $image_tag did not complete. Check the logs: rengine logs migrate"
  fi
  printf 'Updated to %s.\n' "$image_tag"
}

cmd_scale() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] || die "usage: rengine scale <n>"
  if grep -q '^WORKER_SCANS_REPLICAS=' .env; then
    sed -i "s|^WORKER_SCANS_REPLICAS=.*|WORKER_SCANS_REPLICAS=$1|" .env
  else
    printf 'WORKER_SCANS_REPLICAS=%s\n' "$1" >>.env
  fi
  docker compose up -d worker-scans
}

cmd_uninstall() {
  printf 'Containers and data volumes are removed. Backups and .env stay in %s.\n' "$RENGINE_HOME"
  local ans
  read -rp 'Continue? [y/N] ' ans
  case "$ans" in y|Y|yes) ;; *) printf 'Uninstall not run.\n'; return 0 ;; esac
  docker compose down --volumes --remove-orphans
  local link
  link="$(command -v rengine 2>/dev/null || true)"
  if [ -n "$link" ] && [ "$(readlink -f "$link" 2>/dev/null)" = "$SELF" ]; then
    rm -f "$link"
  fi
  printf 'Uninstalled. %s remains.\n' "$RENGINE_HOME"
}

cmd="${1:-}"
shift || true
case "$cmd" in
  start)     docker compose up -d ;;
  stop)      docker compose down ;;
  restart)   docker compose down && docker compose up -d ;;
  status)    cmd_status ;;
  logs)      docker compose logs -f --tail 200 "$@" ;;
  scale)     cmd_scale "${1:-}" ;;
  update)    cmd_update "$@" ;;
  backup)    exec scripts/backup.sh dump "$(abs "${1:-$RENGINE_HOME/backups}")" ;;
  restore)   [ -n "${1:-}" ] || die "usage: rengine restore <archive>"
             exec scripts/backup.sh restore "$(abs "$1")" ;;
  uninstall) cmd_uninstall ;;
  version)   env_get RENGINE_TAG ;;
  ''|help|-h|--help) usage ;;
  *)         die "unknown command: $cmd" ;;
esac
