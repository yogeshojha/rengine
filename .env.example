# Copy to .env before the first `docker compose up`. Every service reads it.
#   cp .env.example .env && sed -i "s/^SECRET_KEY=.*/SECRET_KEY=$(openssl rand -hex 32)/" .env

# ############################################################################
# Application
# ############################################################################
DEBUG=true
LOG_LEVEL=INFO
# echoes every statement and its parameters; never DEBUG for this
SQL_ECHO=false

# ############################################################################
# Database
# ############################################################################
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=rengine
POSTGRES_PASSWORD=rengine
POSTGRES_DB=rengine

# Postgres tuning, applied in the db service's command
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_MAX_CONNECTIONS=250
POSTGRES_LOG_MIN_DURATION=2000
# a parallel hash join that outgrows /dev/shm fails the query, not slows it
POSTGRES_SHM_SIZE=1gb

# ############################################################################
# Connection pools
# ############################################################################
# Budget against POSTGRES_MAX_CONNECTIONS:
#   api    = DB_POOL_SIZE + DB_MAX_OVERFLOW           per uvicorn process
#   worker = WORKER_DB_* sums  x  every CELERY_*_CONCURRENCY  (pool per prefork child)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
# Postgres kills a connection left idle inside a transaction this long (0 = off)
DB_IDLE_TX_TIMEOUT=120

WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=3
WORKER_DB_POOL_TIMEOUT=30

# ############################################################################
# Redis
# ############################################################################
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# optional, and a single shell token: compose passes it to redis-server as an argument
REDIS_PASSWORD=
REDIS_MAXMEMORY=1gb

# ############################################################################
# Celery
# ############################################################################
# stage slots per worker-scans container, one tool each
CELERY_SCAN_CONCURRENCY=16
# launch, step hand-over, resume and finalize
CELERY_CONTROL_CONCURRENCY=4
# background jobs and toolbox runs
CELERY_DEFAULT_CONCURRENCY=4
# both must stay above the task time limit, or a stage is redelivered and a
# chord key expires mid-run
TASK_SOFT_TIME_LIMIT=21600
TASK_HARD_TIME_LIMIT=28800

# ############################################################################
# API
# ############################################################################
# Generate one: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=["http://localhost:5173"]
# true serves one process under --reload; false runs API_WORKERS processes
API_RELOAD=true
API_WORKERS=4
GLOBAL_RATE_LIMIT_PER_MINUTE=600
# comma-separated CIDRs whose X-Forwarded-For is believed
TRUSTED_PROXIES=

# ############################################################################
# First administrator
# ############################################################################
ADMIN_EMAIL=admin@rengine.local
ADMIN_USERNAME=rengine
ADMIN_PASSWORD=rengine@123

# ############################################################################
# Published ports
# ############################################################################
# db, redis and flower are reachable from the host only
BIND_ADDR=127.0.0.1
# api and frontend are reachable from the network
APP_BIND_ADDR=0.0.0.0

# ############################################################################
# Flower, under the debug profile: docker compose --profile debug up -d flower
# ############################################################################
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# ############################################################################
# Outbound calls that are not scan traffic: intel feeds, RDAP, RIPEstat
# ############################################################################
EGRESS_PROXY_URL=
EGRESS_TIMEOUT=30
